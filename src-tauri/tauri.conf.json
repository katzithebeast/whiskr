{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whiskr",
  "version": "0.17.1",
  "identifier": "app.whiskr.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Whiskr",
        "url": "index.html",
        "width": 960,
        "height": 660,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": false,
        "transparent": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "bar",
        "title": "Whiskr bar",
        "url": "bar.html",
        "width": 540,
        "height": 120,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": true,
        "visibleOnAllWorkspaces": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --autoplay-policy=no-user-gesture-required"
      },
      {
        "label": "ask",
        "title": "Whiskr Ask",
        "url": "ask.html",
        "width": 700,
        "height": 62,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/recordings/**",
          "$APPDATA/backgrounds/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Whiskr",
    "shortDescription": "Speak. Whiskr does the rest.",
    "longDescription": "Voice dictation for every app. Hold a key, speak, and clean text appears where your cursor is.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}